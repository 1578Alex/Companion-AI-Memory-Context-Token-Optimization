{
  "spec_version": "0.3.0",
  "status": "design_only_not_a_coopanion_config",
  "budgets": {
    "memory_snapshot_tokens": 1600,
    "pinned_tokens": 160,
    "hot_tokens": 960,
    "recalled_tokens": 480,
    "allow_cross_bucket_borrowing": false,
    "include_serialization_overhead": true,
    "recent_history_tokens": 2000,
    "recent_history_max_completed_interactions": 6,
    "token_counter_mode": "provider_specific_required_for_verified_cap"
  },
  "selection": {
    "max_pinned_items": 4,
    "max_hot_pool_items": 64,
    "max_hot_items_per_request": 8,
    "max_hot_items_per_topic": 2,
    "max_recalled_items_per_request": 3,
    "require_current_topic_relevance": true,
    "hot_order": [
      "heat_desc",
      "last_user_mention_at_desc",
      "id_asc"
    ],
    "recall_only_overrides_pin_heat_and_ongoing": true,
    "optional_vector_ranking_profile": "vector-ranking.example.json",
    "hot_order_is_fallback_when_vector_profile_disabled_or_unavailable": true,
    "vector_ranking_must_preserve_priority_classes_and_type_budgets": true
  },
  "heat": {
    "eligible_source": "verified_substantive_user_mention",
    "exclude_cue_only_queries": true,
    "max_mentions_per_fact_per_interaction": 1,
    "max_mentions_per_fact_per_day": 3,
    "counting_timezone": "Asia/Shanghai",
    "frequency_window_days": 30,
    "frequency_saturation_count": 6,
    "recency_half_life_days": 7,
    "weights": {
      "frequency": 0.45,
      "recency": 0.35,
      "ongoing": 0.2
    }
  },
  "lifecycle": {
    "new_memory_hot_candidate_days": 7,
    "demote_heat_below": 0.3,
    "demote_inactive_after_days": 14,
    "cold_promotion_window_days": 7,
    "cold_promotion_min_interactions": 3,
    "cold_promotion_min_distinct_dates": 2,
    "ongoing_review_max_days": 30,
    "capacity_eviction_action": "verified_summary_before_eviction_then_archive_without_deletion_with_reason",
    "pin_overflow_action": "report_pending_and_request_replacement",
    "representation_policy": {
      "status": "design_only_experimental_defaults",
      "stages": [
        "detail",
        "summary",
        "cold"
      ],
      "stage_is_not_a_new_storage_tier": true,
      "applies_to": "ordinary_event_and_fact_cards",
      "exclude_types": [
        "base_persona",
        "continuity_state",
        "pinned"
      ],
      "clock": "continuous_elapsed_hours_since_last_verified_substantive_user_mention",
      "detail_preferred_hours": 72,
      "summary_eligible_min_hours_before_ordinary_cold": 24,
      "ordinary_cold_not_before_candidate_grace_days": 7,
      "ordinary_cold_trigger": "no_valid_ongoing_and_summary_eligible_interval_elapsed_and_any_ordinary_heat_or_inactivity_trigger",
      "fresh_user_mention_can_refresh_non_cold_detail_stage": true,
      "assistant_retry_recall_and_summary_refresh_clock": false,
      "midnight_or_restart_resets_stage": false,
      "prepare_source_backed_representations_from_incremental_events": true,
      "summary_of_summary_updates": false,
      "one_visible_representation_per_record_id": true,
      "preserve_fields": [
        "speaker",
        "negation",
        "reported_at",
        "occurred_time_if_known",
        "identity_and_distinctive_quote_when_needed",
        "open_commitment_owner_conditions_and_review",
        "source_refs"
      ],
      "active_ongoing_action": "retain_bounded_relevant_summary_until_review_not_unlimited_detail",
      "expired_unresolved_commitment_action": "needs_review_not_completed",
      "privacy_correction_delete_override_stages_immediately": true,
      "budget_order": [
        "enforce_permissions_status_and_current_topic_relevance",
        "protect_bounded_current_task_or_open_commitment_core_fields",
        "choose_age_appropriate_verified_representation",
        "compress_low_priority_detail_to_verified_summary",
        "evict_low_priority_whole_records_with_exclusion_reason"
      ],
      "ordinary_record_priority_order": [
        "current_relevant_open_task_core_first",
        "heat_desc",
        "last_user_mention_at_desc",
        "id_asc"
      ],
      "parent_item_topic_token_and_pool_limits_still_apply": true,
      "summary_unavailable_action": "bounded_last_valid_detail_if_still_hot_eligible_else_exclude_or_cold_with_quality_reason",
      "capacity_can_override_preferred_transition_with_recorded_reason": true,
      "lazy_evaluation_may_skip_user_visible_intermediate_stage": true,
      "cold_detail_restore_requires_existing_cue_or_promotion_permission": true,
      "raw_source_retained_except_explicit_user_delete": true
    }
  },
  "recall": {
    "mode": "user_cue_required",
    "allow_ambient_event_trigger": false,
    "allow_assistant_self_trigger": false,
    "allow_tool_output_trigger": false,
    "max_index_candidates": 12,
    "max_search_attempts_per_explicit_cue": 1,
    "max_followup_user_interactions": 5,
    "max_scope_minutes": 30,
    "expire_on_topic_change": true,
    "auto_extend_on_followup": false,
    "increment_heat_on_read": false,
    "auto_promote_on_recall": false,
    "ambiguous_or_no_hit_action": "ask_one_user_cue",
    "max_candidate_cards": 3,
    "cards_share_recalled_item_and_token_budget": true,
    "max_index_candidates_stage": "fused_candidates_to_body_selection",
    "optional_vector_profile_internal_refs_are_bounded_and_not_model_output": true
  },
  "context": {
    "replace_snapshot_instead_of_appending": true,
    "remove_expired_recall_copies": true,
    "preserve_active_tool_transaction": true,
    "overflow_action": "stop_new_batch_or_rebuild_at_safe_boundary",
    "stable_prefix_before_dynamic_memory": true,
    "validate_full_request_and_output_reserve": true
  },
  "maintenance": {
    "decay_evaluation": "lazy_at_next_user_interaction",
    "extract_from_incremental_events_only": true,
    "extractor_max_candidate_changes": 12,
    "cue_router_llm": "optional_fallback",
    "include_maintenance_in_cost_report": true
  },
  "storage": {
    "archive_every_user_and_assistant_dialogue_turn": true,
    "retain_raw_text_without_memory_card": true,
    "memory_cards_are_derived_pointers_not_the_only_archive": true,
    "explicit_user_delete_removes_raw_and_derived_copies": true,
    "cold_access": "host_mediated",
    "allow_generic_tool_bypass": false,
    "filter_owner_and_scope_before_retrieval": true,
    "exclude_superseded_and_deleted_by_default": true,
    "remove_derived_data_on_explicit_delete": true
  },
  "index": {
    "dimensions": [
      "types",
      "occurred_time",
      "places",
      "people",
      "objects",
      "topics"
    ],
    "max_values_per_dimension": 4,
    "single_record_multiple_index_entries": true,
    "permission_filters": [
      "owner_id",
      "scope_id",
      "status"
    ],
    "single_usable_facet_can_start_retrieval": true,
    "missing_facets_are_not_required": true,
    "vague_time_does_not_imply_exact_year": true,
    "send_full_index_to_model": false,
    "candidate_limit_is_global_not_per_partition": true,
    "uncertain_match_action": "bounded_candidate_cards_or_one_clarification",
    "expand_explicit_filters_without_new_user_cue": false
  }
}
