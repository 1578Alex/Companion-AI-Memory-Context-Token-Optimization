        "inject_only_one_current_version": true,
        "source_watermark": "event-204",
        "cold_search": false,
        "scan_cold_archive_for_missing_state": false,
        "first_response_uses_base_persona_and_current_continuity": true,
        "base_persona_version_matches_authorized_role": true
      }
    },
    {
