  "cases": [
    {
      "id": "P01",
      "name": "Midnight does not reset the persona or relationship baseline",
      "setup": "The same user, persona, and model are used; the current snapshot was committed before midnight.",
      "input": {
        "saved_at": "2026-10-25T23:59:00+08:00",
        "request_at": "2026-10-26T00:01:00+08:00",
        "base_persona_version": "persona-3",
        "state_version": 12,
        "slow_style": {
          "playfulness": 0.6
        },
        "current_user_message": "I'm still awake. Let's keep talking."
      },
      "expected": {
        "base_persona_version": "persona-3",
        "state_reset_at_midnight": false,
        "relationship_baseline_reset": false,
        "slow_style_without_new_evidence": {
          "playfulness": 0.6
        },
        "cold_search": false,
        "elapsed_time_basis": "continuous_elapsed_time"
      }
    },
    {
      "id": "P02",
      "name": "Eight- and 24-hour gaps decay once using elapsed time",
      "setup": "This tests only deterministic elapsed-time calculation for a transient state. There are no new events and no slow-style update.",
      "input": {
        "as_of": "2026-10-25T22:00:00+08:00",
        "baseline": 0.4,
        "saved_state": 0.8,
        "half_life_hours": 12,
        "evaluate_at": [
          "2026-10-26T06:00:00+08:00",
          "2026-10-26T22:00:00+08:00"
        ],
        "repeat_same_timestamp": true
      },
      "expected": {
        "samples": [
          {
            "elapsed_hours": 8,
            "remaining_offset_ratio": 0.6299605249474366,
            "state": 0.6519842099789747
          },
          {
            "elapsed_hours": 24,
            "remaining_offset_ratio": 0.25,
            "state": 0.5
          }
        ],
        "numeric_tolerance": 1e-09,
        "no_double_decay_for_same_timestamp": true,
        "slow_style_changed": false,
        "idle_model_calls": 0
      }
    },
    {
