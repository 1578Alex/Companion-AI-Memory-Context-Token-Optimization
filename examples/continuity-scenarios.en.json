        "after_forget": {
          "raw_and_derived_records_removed": true,
          "derived_ids_removed": [
            "anchor-private-1",
            "state-fragment-private-1"
          ],
          "recompute_current_state_from_remaining_allowed_evidence": true,
          "restore_from_old_snapshot": false,
          "reimport_deleted_source": false
        }
