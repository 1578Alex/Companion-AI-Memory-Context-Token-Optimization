            "event_id": "u-207",
            "action": "cold_only",
            "text": "Bring this up only if I ask about it."
          },
          {
            "event_id": "u-208",
            "action": "forget",
            "text": "Delete this matter and its related records."
          }
        ]
      },
      "expected": {
        "after_cold_only": {
          "include_in_always_visible_continuity": false,
          "include_in_recent_anchors": false,
          "raw_record_retained": true,
          "recall_requires_user_cue": true
