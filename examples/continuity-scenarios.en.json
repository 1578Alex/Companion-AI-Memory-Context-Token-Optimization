    {
      "id": "P08",
      "name": "Recall-only restrictions and deletion also apply to derived continuity",
      "setup": "A source is referenced by both a recent anchor and a state summary. The user first restricts proactive use, then explicitly deletes it.",
      "input": {
        "source_event_id": "u-private-1",
        "derived_ids": [
          "anchor-private-1",
          "state-fragment-private-1"
