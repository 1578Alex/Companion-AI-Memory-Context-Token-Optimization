          },
          {
            "id": "anchor-followup",
            "speaker": "assistant",
            "source_event_id": "a-180",
            "commitment_owner": "assistant",
            "status": "unresolved",
            "exact_quote": "Next time we can look at how to arrange it together.",
            "reported_at": "2026-10-22T23:00:00+08:00"
          }
