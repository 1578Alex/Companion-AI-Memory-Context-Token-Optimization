{
  "notice": "虚构的主动陪伴验收规格，尚未实现或运行。expected为待验证要求，合成计数不代表模型实测。",
  "profile_version": "0.4.0",
  "cases": [
    {
      "id": "A01",
      "name": "默认模式不因“累”搜索冷库",
      "setup": "扩展未获明确开启。",
      "input": {
        "mode": "cue_only",
        "user_message": "tired",
        "specific_recall_cue": false
      },
      "expected": {
        "cold_search": false,
        "background_search": false,
        "base_gate_unchanged": true
      }
    },
    {
      "id": "A02",
      "name": "主动模式只轻问历史关联",
      "setup": "合成用户先前明确说过加班很累，今天只说累。",
      "input": {
        "mode": "proactive",
        "opt_in": true,
        "allowed_category": "routine_work",
        "source_event": {
          "id": "u-01",
          "role": "user",
          "text": "Last week overtime exhausted me."
        },
        "current_user_event": {
          "id": "u-02",
          "role": "user",
          "text": "I am exhausted."
        }
      },
      "expected": {
        "retrieval_flows_max": 1,
        "proactive_event_items_max": 2,
        "action": "ask",
        "assert_overtime_today": false,
        "heat_increment_from_recall": 0
      }
    },
    {
      "id": "A03",
      "name": "问到再说优先于情绪联想",
      "setup": "用户开启主动模式但限制这件事。",
      "input": {
        "opt_in": true,
        "record": {
          "id": "e-01",
          "recall_only": true
        },
        "specific_recall_cue": false,
        "emotion_similarity": 0.99
      },
      "expected": {
        "read_restricted_record": false,
        "mention_record": false,
        "clear_recall_only": false
      }
    },
    {
