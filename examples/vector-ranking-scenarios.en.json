    {
      "id": "V05",
      "name": "Take fewer records when the budget is full",
      "setup": "Token counts include framing and are synthetic verified-counter inputs. Each record already uses its shortest valid summary.",
      "input": {
        "cold_max_items": 3,
        "cold_budget_tokens": 480,
        "ranked_candidates": [
          {
            "id": "a",
            "tokens": 180
          },
          {
            "id": "b",
            "tokens": 180
          },
          {
            "id": "c",
            "tokens": 180
