    {
      "id": "V06",
      "name": "An exact match remains retrievable without an embedding",
      "setup": "A candidate has no embedding. Apply one fallback ranker to the batch rather than treating missing values as zero.",
      "input": {
        "user_cue_authorized": true,
        "query": "That film camera in Xi'an in 2016",
        "candidates": [
          {
            "id": "exact-no-vector",
            "embedding_ref": null,
            "C": 1,
            "host_lexical_score": 0.95
          },
          {
            "id": "other-compatible",
            "embedding_ref": "host-vector-2",
            "C": 1,
            "host_lexical_score": 0.85
          }
        ]
      },
      "expected": {
        "mode": "uniform_typed_fallback_for_same_candidate_batch",
        "ranked_ids": [
          "exact-no-vector",
          "other-compatible"
        ],
        "invent_S": false,
        "discard_exact_match_for_missing_embedding": false,
        "permissions_relaxed": false,
        "cold_order": [
          "verified_strong_exact_match_first",
          "verified_cue_match_desc",
          "uniform_host_lexical_score_desc",
          "memory_id_asc"
        ],
        "mix_vector_and_lexical_scores": false
      }
    },
