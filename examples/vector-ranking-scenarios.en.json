{
  "notice": "Synthetic vector-ranking acceptance specifications, not implemented or executed. Similarities, lexical scores, and token counts are fixture inputs; expected fields are requirements, not measured embedding, model, or cost results.",
  "profile_version": "0.3.0",
  "score_tolerance": 1e-09,
  "cases": [
    {
      "id": "V01",
      "name": "A ten-year-old Xi’an event is not buried by age",
      "setup": "Synthetic cold events in one authorized user scope. Similarities are supplied fixture values, not measured embeddings.",
      "input": {
        "query": "Do you remember buying that camera in Xi'an years ago?",
        "user_cue_authorized": true,
        "now": "2026-10-27T09:00:00+08:00",
        "candidates": [
          {
            "id": "old-xian-camera",
            "occurred_time": "2016-10-01",
            "last_user_mention_at": "2016-10-02T10:00:00+08:00",
            "place": "Xi'an",
            "object": "film camera",
            "S": 0.94,
            "C": 1.0,
            "explicit_filters_pass": true
          },
          {
            "id": "yesterday-xian-camera",
            "occurred_time": "2026-10-26",
            "last_user_mention_at": "2026-10-26T20:00:00+08:00",
            "place": "Xi'an",
            "object": "camera",
            "S": 0.7,
            "C": 1.0,
            "explicit_filters_pass": true
          },
          {
            "id": "yesterday-unrelated",
            "occurred_time": "2026-10-26",
            "place": "Hangzhou",
            "object": "coffee",
            "S": 0.25,
            "C": 0.0,
            "explicit_filters_pass": false
          }
        ]
      },
      "expected": {
        "cold_scores": {
          "old-xian-camera": 0.952,
          "yesterday-xian-camera": 0.76
        },
        "ranked_ids": [
          "old-xian-camera",
          "yesterday-xian-camera"
        ],
        "excluded_ids": [
          "yesterday-unrelated"
        ],
        "age_decay_applied": false,
        "ambiguous_if_user_cue_does_not_uniquely_identify_event": true,
        "do_not_assume_top1_is_confirmed": true,
        "raw_source_retained": true,
        "auto_promote_on_recall": false
      }
    },
    {
      "id": "V02",
      "name": "An explicit year uses event time, not last mention",
      "setup": "The user explicitly supplies 2016; unknown time cannot count as a confirmed match.",
      "input": {
        "query": "Which camera did I buy in Xi'an in 2016?",
        "explicit_year": 2016,
        "candidates": [
          {
            "id": "event-2016",
            "occurred_year": 2016,
            "last_mention_year": 2020
          },
          {
            "id": "event-2025",
            "occurred_year": 2025,
            "last_mention_year": 2016
          },
          {
            "id": "event-unknown",
            "occurred_year": null,
            "last_mention_year": 2016
          }
        ]
      },
      "expected": {
        "confirmed_time_match_ids": [
          "event-2016"
        ],
        "excluded_known_conflict_ids": [
          "event-2025"
        ],
        "unknown_not_confirmed_ids": [
          "event-unknown"
        ],
        "filter_uses": "occurred_time",
        "ask_before_relaxing_explicit_year": true
      }
    },
    {
      "id": "V03",
      "name": "Recency cannot admit an irrelevant event",
      "setup": "Both hot candidates are valid, but only one is relevant. Heat admission and request ranking are distinct.",
      "input": {
        "candidates": [
          {
            "id": "related-week-old",
            "S": 0.9,
            "R": 0.5,
            "F": 0.5,
            "O": 0,
            "current_relevance_pass": true
          },
          {
            "id": "unrelated-fresh",
            "S": 0.1,
            "R": 1,
            "F": 1,
            "O": 1,
            "current_relevance_pass": false
          }
        ]
      },
      "expected": {
        "eligible_ids": [
          "related-week-old"
        ],
        "hot_scores": {
          "related-week-old": 0.735
        },
        "excluded_ids": [
          "unrelated-fresh"
        ],
        "add_hot_score_to_heat": false,
        "refresh_last_mention_on_read": false
      }
    },
